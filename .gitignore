.junie/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
# .vscode/

# Local logs and scratch/prototype files
.goland.logs
go.main

# Build output
bin/
dist/
/gotail
/graytail
/grayquery
graytail-*.zip
graytail_*.deb
