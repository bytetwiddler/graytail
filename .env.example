# Example .env for gotail (copy to .env and edit)
#
# These variables are shared by both binaries in this module:
#   - graytail  (live tail of Graylog logs)
#   - grayquery (bounded begin/end keyword search)
# Both read config in the order: flag > env > .env > default.
#
# Graylog URL must include port if required and can be host-only if /etc/hosts is used.
GRAYLOG_URL=https://<somegraylogserver>:9000
# API token for Graylog (keep secret)
GRAYLOG_API_TOKEN=replace_me_with_real_token
# Optional: stream ID to target (default is all messages)
GRAYLOG_STREAM_ID=000000000000000000000001

# Optional shared overrides (used by both graytail and grayquery):
# TIMEOUT=60s      # per-request timeout
# INSECURE=false   # true or false (skip TLS verification)
# LIMIT=100        # max messages per request (grayquery also pages by this)

# Optional graytail-only overrides:
# POLL=10s         # polling interval, e.g. 5s, 1m
# LOOKBACK=30      # seconds for initial lookback
# DUP_RETENTION=1h # how long to remember seen messages for de-duplication

# Optional grayquery-only override:
# TIMEZONE=UTC    # timezone used to resolve --begin/--end keyword bounds (or --timezone/-tz)

# grayquery takes its time window and query on the command line, e.g.:
#   grayquery -b "2024-01-02 15:04:05" -e "2024-01-02 16:04:05" -o line "source:web AND level:3"
